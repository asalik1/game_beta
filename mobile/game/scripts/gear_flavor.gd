## The flavor line for an item Dictionary, or "" when it has none. Safe on any value.
static func of(item) -> String:
	if not (item is Dictionary):
		return ""
	if bool(item.get("gem", false)):
		var gname := String(Items.GEM_STATS.get(item.get("stat", ""), {}).get("name", ""))
		if gname == "":
			return ""
		var gkey := gname + "|" + _gem_band(int(item.get("lvl", 1)))
		return String(FLAVOR.get(gkey, FLAVOR.get(gname, "")))
	var nm := String(item.get("name", ""))
	if nm != "" and FLAVOR.has(nm):
		return String(FLAVOR[nm])
	var noun := String(item.get("noun", ""))
	if noun != "":
		var bkey := noun + "|" + _grade_band(String(item.get("grade", "")))
		if FLAVOR.has(bkey):
			return String(FLAVOR[bkey])
		if FLAVOR.has(noun):
			return String(FLAVOR[noun])
	return ""


static func _gem_band(lvl: int) -> String:
	if lvl <= 3: return "Lv1-3"
	if lvl <= 6: return "Lv4-6"
	if lvl <= 9: return "Lv7-9"
	return "Lv10"


static func _grade_band(g: String) -> String:
	if g == "F" or g == "E": return "F-E"
	if g == "D" or g == "C": return "D-C"
	if g == "B" or g == "A": return "B-A"
	if g == "S": return "S"
	return "D-C"
