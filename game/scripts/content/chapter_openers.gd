							"ch8_cool_the_forge": true,
						},
						"next": "reply_virtue",
					},
					{
						"text": "The texts. Before anything burns, the texts — one binding grammar, applied at home, and the tome finally answers questions.",
						"resonance": -6.0,
						"flags": {
							"ch8_studied_binding": true,
						},
						"next": "reply_temptation",
					},
					{
						"text": "Banks fall; debtors walk out in the confusion. The vessel, then the door, and no withdrawals.",
						"resonance": 0.0,
						"flags": {
							"ch8_here_for_vessel": true,
						},
						"next": "reply_deflection",
					},
				],
			},
			"reply_virtue": {
				"who": "Narrator",
				"text": "The Ember answers with heat, then yields. For once, you carry it instead of being carried.",
				"next": "n_end",
			},
			"reply_temptation": {
				"who": "Narrator",
				"text": "The Ember warms as if recognized. The chapter ahead has heard your answer.",
				"next": "n_end",
			},
			"reply_deflection": {
				"who": "Narrator",
				"text": "The question follows when you decline to answer it. Silence is still a direction.",
				"next": "n_end",
