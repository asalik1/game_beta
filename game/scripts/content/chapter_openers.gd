						"flags": {
							"ch7_would_speak": true,
						},
						"next": "reply_virtue",
					},
					{
						"text": "You've always wanted to know what walks in when the door opens. His door. Safer than yours. Let it.",
						"resonance": -6.0,
						"flags": {
							"ch7_let_it_end": true,
						},
						"next": "reply_temptation",
					},
					{
						"text": "Two open doors on one ridge is one too many. Kill the drake, keep your own latch, let the sky mind its manners.",
						"resonance": 0.0,
						"flags": {
							"ch7_hears_wind": true,
						},
						"next": "reply_deflection",
					},
				],
			},
			"reply_virtue": {
				"who": "Narrator",
				"text": "The Ember answers with heat, then yields. For once, you carry it instead of being carried.",
				"next": "n_end",
			},
			"reply_temptation": {
				"who": "Narrator",
				"text": "The Ember warms as if recognized. The chapter ahead has heard your answer.",
				"next": "n_end",
			},
			"reply_deflection": {
				"who": "Narrator",
				"text": "The question follows when you decline to answer it. Silence is still a direction.",
				"next": "n_end",
			},
			"n_end": {
				"who": "Narrator",
				"cue": "fade",
				"text": "Upward: Summit Camp, the relay, and the sky coming apart.",
			},
