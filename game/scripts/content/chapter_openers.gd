						"flags": {
							"ch9_seals_behind": true,
						},
						"next": "reply_deflection",
					},
				],
			},
			"reply_virtue": {
				"who": "Narrator",
				"text": "The Ember answers with heat, then yields. For once, you carry it instead of being carried.",
				"next": "n_end",
