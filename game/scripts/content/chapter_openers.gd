				"who": "Narrator",
				"text": "The question follows when you decline to answer it. Silence is still a direction.",
				"next": "n_end",
			},
			"n_end": {
				"who": "Narrator",
				"cue": "fade",
				"text": "The plank road enters the Pilgrim Gate. Everything beyond it grows.",
			},
