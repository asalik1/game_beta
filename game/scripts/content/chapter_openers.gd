						"flags": {
							"ch7_let_it_end": true,
						},
						"next": "reply_temptation",
					},
					{
						"text": "Never touch a taut line mid-song. Drake first; the thread was holding fine before you got here.",
						"resonance": 0.0,
						"flags": {
							"ch7_hears_wind": true,
						},
						"next": "reply_deflection",
