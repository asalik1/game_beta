						},
						"next": "reply_virtue",
					},
					{
						"text": "Read the fine print. A bigger lender means better terms — or a way to refinance what you owe the tome.",
						"resonance": -6.0,
						"flags": {
							"ch4_heard_verdict": true,
						},
						"next": "reply_temptation",
					},
					{
						"text": "No new paper. In and out, vessel dead, signature withheld.",
						"resonance": 0.0,
						"flags": {
							"ch4_not_my_court": true,
						},
						"next": "reply_deflection",
